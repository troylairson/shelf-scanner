# Copy to .env.local for local development. NEVER commit .env.local.
# Expo inlines EXPO_PUBLIC_* values into the app bundle, so nothing here is secret.

# Where the app sends photos. Leave unset in development: the app then uses
# `wrangler dev` on the same machine as Metro (http://<your-LAN-IP>:8787).
# Set it to your deployed Worker for anything else.
# EXPO_PUBLIC_API_URL=https://shelf-scanner.<your-subdomain>.workers.dev

# Optional: must match the Worker's APP_TOKEN secret. Deters casual abuse only.
# EXPO_PUBLIC_APP_TOKEN=

# The Gemini key lives in the Worker, never in the app:
#   worker/.dev.vars  ->  GEMINI_API_KEY=AIza...   (local)
#   cd worker && npx wrangler secret put GEMINI_API_KEY   (deployed)
# Get a free key at https://aistudio.google.com/app/apikey
